<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/nem_overlay" android:orientation="vertical" android:padding="6dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:id="@+id/btn_drag" android:layout_width="34dp" android:layout_height="38dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Déplacer le panneau NemApiBridge" android:src="@android:drawable/ic_menu_sort_by_size" android:tint="#71DCCF"/>
    <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="3dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEM API" android:textColor="#EFF8FA" android:textStyle="bold" android:textSize="10sp"/><TextView android:id="@+id/txt_floating_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:text="Arrêté" android:textColor="#7DE5D4" android:textSize="9sp"/></LinearLayout>
    <Button android:id="@+id/btn_start_api" style="@style/NemSecondary" android:layout_width="66dp" android:layout_height="38dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="2dp" android:text="Arrêter" android:textSize="10sp"/>
    <Button android:id="@+id/btn_expand" style="@style/NemNav" android:layout_width="34dp" android:layout_height="38dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="⋯" android:textColor="#EFF8FA" android:textSize="20sp" android:contentDescription="Afficher les outils du panneau"/>
    <ImageButton android:id="@+id/btn_close" android:layout_width="32dp" android:layout_height="38dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Fermer NemApiBridge" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#BDD5DA"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/extra_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
    <Button android:id="@+id/btn_stop_generation" style="@style/NemSecondary" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:minHeight="0dp" android:text="Stop génération" android:textSize="10sp"/>
    <Button android:id="@+id/btn_inspect_ui" style="@style/NemSecondary" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="5dp" android:minHeight="0dp" android:text="Inspecter UI" android:textSize="10sp"/>
  </LinearLayout>
</LinearLayout>